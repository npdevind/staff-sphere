# =============================================================================
# StaffSphere Client - Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Modify the values in .env if needed
#
# Vite exposes env variables to the browser only if they start with VITE_
# Access them in code as: import.meta.env.VITE_API_BASE_URL
# =============================================================================

# Backend API base URL
# In development, we use Vite's proxy (defined in vite.config.js) so '/api' works
# In production, change this to your actual backend URL
VITE_API_BASE_URL=/api
