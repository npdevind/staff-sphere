# =============================================================================
# StaffSphere Server - Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual database credentials in the .env file
#   3. NEVER commit the .env file to version control (it's in .gitignore)
#
# PHP Equivalent:
#   In PHP, you might use $_ENV['DB_HOST'] or define('DB_HOST', 'localhost')
#   In Node.js, we use the dotenv package to load these into process.env
#   Then access them as: process.env.DB_HOST
# =============================================================================

# Server Configuration
# The port your Express server will listen on (default: 5000)
PORT=5000

# Node environment: 'development' or 'production'
# In development mode, more detailed error messages are shown
NODE_ENV=development

# =============================================================================
# PostgreSQL Database Configuration
# PHP equivalent: $host, $dbname, $user, $password in your PDO connection string
# =============================================================================

# Database server host (usually 'localhost' for local development)
DB_HOST=localhost

# PostgreSQL port (default is 5432)
DB_PORT=5432

# The name of your database (we created this in schema.sql)
DB_NAME=employee_management

# Your PostgreSQL username (default is 'postgres')
DB_USER=postgres

# Your PostgreSQL password (replace with your actual password)
DB_PASSWORD=your_password_here

# =============================================================================
# CORS Configuration
# =============================================================================
# CORS (Cross-Origin Resource Sharing) controls which websites can call your API.
# In PHP, this is usually set via headers like: header('Access-Control-Allow-Origin: *')
# Here we specify the exact origin of our React frontend.
CLIENT_URL=http://localhost:5173
