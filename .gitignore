# =============================================================================
# .gitignore - Files and folders to exclude from version control
# =============================================================================
# NEVER commit these files to Git:
#   - .env files (contain passwords and secrets!)
#   - node_modules (huge folder, always install fresh with npm install)
#   - build output (generated files, not source code)
# =============================================================================

# Environment variable files (IMPORTANT: these contain secrets!)
.env
.env.local
.env.production

# Node.js dependencies (install with: npm install)
node_modules/
*/node_modules/

# Frontend build output (generated by: npm run build)
client/dist/

# Backend logs
*.log
logs/

# OS generated files
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
tmp/
